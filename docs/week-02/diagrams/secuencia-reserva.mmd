%% BibliotecaViva — Secuencia de reserva por bloque con QR (revisión semana 3)
%% Fuente de verdad del diagrama. Sintaxis Mermaid (GitHub).
%% 13 bloques de 09:00 a 22:00; antelación mínima de 15 minutos; horizonte de 7 días.

sequenceDiagram
  actor U as Usuario
  participant UI as Interfaz web
  participant BE as Backend
  participant SR as Servicio de reservas
  participant SS as Servicio de sanciones
  participant RRes as Repositorio de reservas
  participant RRec as Repositorio de recursos
  participant QR as Servicio QR

  U->>UI: Selecciona recurso, fecha y bloque
  UI->>BE: Solicitar reserva
  BE->>SR: crearReserva(usuario, recurso, fecha, bloque)
  SR->>SR: validar ventana (09:00–22:00, 15 min, 7 días)
  alt Fecha o bloque inválido
    SR-->>BE: Rechazar
    BE-->>UI: Error de fecha/bloque
    UI-->>U: Mostrar error bajo el campo
  else Ventana válida
    SR->>SS: verificarSancion(usuario)
    SS-->>SR: Sanción vigente o habilitado
    alt Usuario sancionado (RF-07)
      SR-->>BE: Rechazar
      BE-->>UI: Error de sanción
      UI-->>U: Mostrar aviso
    else Habilitado
      SR->>RRes: contarReservasActivas(usuario, fecha)
      alt Límite de 2 por día (RF-06)
        SR-->>BE: Rechazar
        BE-->>UI: Error de cupo
        UI-->>U: Mostrar límite
      else Cupo disponible
        SR->>RRec: verificarDisponibilidad(recurso, fecha, bloque)
        alt Recurso ocupado
          SR-->>BE: Rechazar
          BE-->>UI: Error de disponibilidad
          UI-->>U: Mostrar recurso ocupado
        else Recurso libre
          SR->>RRes: guardarReserva
          SR->>QR: generarQR(idReserva)
          QR-->>SR: QR único
          SR-->>BE: Reserva + QR
          BE-->>UI: Confirmación
          UI-->>U: Mostrar QR
        end
      end
    end
  end
