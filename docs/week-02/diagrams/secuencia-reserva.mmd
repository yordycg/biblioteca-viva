%% BibliotecaViva — Secuencia de reserva con QR
%% Fuente de verdad del diagrama. Sintaxis Mermaid (GitHub).
%% Transcrito el 2026-11-05 desde sem2-t2-diagrama-secuencia.png (entrega de SEM2-T2
%% de Héctor Oviedo), para que la fuente y la exportación coincidan.
%% Pendiente: el diseño entregado separa servicios y repositorios (microservicios),
%% fuera del alcance declarado en AGENTS.md. Ver OBS-LOCAL-02 / HAL-05.

sequenceDiagram
  actor U as Usuario
  participant UI as Interfaz web
  participant BE as Backend
  participant SR as Servicio de reservas
  participant SS as Servicio de sanciones
  participant RRes as Repositorio de reservas
  participant RRec as Repositorio de recursos
  participant QR as Servicio QR

  U->>UI: Selecciona recurso, fecha y bloque
  UI->>BE: Solicitar reserva
  BE->>SR: crearReserva(datos)
  SR->>SS: verificarSancion(usuarioId)
  SS-->>SR: Resultado de sanción

  alt Usuario sancionado (RF-07)
    SR-->>BE: Rechazar reserva
    BE-->>UI: Error: usuario sancionado
    UI-->>U: Mostrar mensaje de sanción
  else Usuario habilitado
    SR->>RRes: contarReservasActivas(usuarioId, fecha)
    RRes-->>SR: Cantidad de reservas
    alt Límite diario alcanzado (RF-06)
      SR-->>BE: Rechazar reserva
      BE-->>UI: Error: máximo 2 reservas
      UI-->>U: Mostrar límite diario
    else Tiene cupo disponible
      SR->>RRec: verificarDisponibilidad(recurso, fecha, bloque)
      RRec-->>SR: Disponibilidad
      alt Recurso ocupado
        SR-->>BE: Rechazar reserva
        BE-->>UI: Error: recurso no disponible
        UI-->>U: Mostrar recurso ocupado
      else Recurso disponible
        SR->>RRes: guardarReserva(datos)
        RRes-->>SR: Reserva registrada
        SR->>QR: generarQR(idReserva)
        QR-->>SR: QR único
        SR->>RRes: asociarQR(idReserva, QR)
        RRes-->>SR: Confirmación
        SR-->>BE: Reserva y QR
        BE-->>UI: Confirmación de reserva
        UI-->>U: Mostrar código QR
      end
    end
  end
