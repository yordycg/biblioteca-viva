classDiagram
  class Usuario {
    +int idUsuario
    +string nombre
    +string correo
    +string rol
    +realizarReserva()
    +consultarReservas()
  }

  class Recurso {
    +int idRecurso
    +string nombre
    +string tipo
    +string estado
    +verificarDisponibilidad()
    +bloquearRecurso()
    +liberarRecurso()
  }

  class Reserva {
    +int idReserva
    +date fecha
    +string bloqueHorario
    +string estado
    +datetime fechaCreacion
    +crearReserva()
    +iniciarUso()
    +finalizarReserva()
  }

  class QR {
    +int idQR
    +string codigo
    +datetime fechaGeneracion
    +boolean utilizado
    +generarQR()
    +validarQR()
  }

  class Sancion {
    +int idSancion
    +date fechaInicio
    +date fechaFin
    +string motivo
    +string estado
    +registrarSancion()
    +verificarVigencia()
  }

  Usuario "1" --> "0..*" Sancion : recibe
  Usuario "1" --> "0..*" Reserva : realiza
  Recurso "1" --> "0..*" Reserva : corresponde
  Reserva "1" *-- "1" QR : posee
