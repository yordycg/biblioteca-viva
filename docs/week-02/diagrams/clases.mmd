%% BibliotecaViva — Modelo de clases del MVP (revisión semana 3)
%% Fuente de verdad del diagrama. Sintaxis Mermaid (GitHub).
%% Actualizado el 2026-11-12: Libro, préstamo y 13 bloques.

classDiagram
  class Usuario {
    +int id
    +string username
    +string email
    +string rol
    +datetime sancionado_hasta
    +estaSancionado()
  }

  class Recurso {
    +int id
    +string nombre
    +string tipo
    +string ubicacion
    +int capacidad
    +string codigo
    +string estado
  }

  class Libro {
    +string autor
    +string editorial
    +int anio
    +string isbn
    +string genero
    +int paginas
    +text sinopsis
    +string portada
  }

  class Reserva {
    +int id
    +date fecha
    +string modalidad
    +string bloque
    +date fecha_vencimiento
    +string estado
    +datetime iniciada_en
    +datetime finalizada_en
    +string codigo
  }

  class QR {
    +int id
    +string codigo
    +boolean utilizado
    +datetime generado_en
  }

  class Sancion {
    +int id
    +datetime inicio
    +datetime fin
    +string motivo
  }

  Recurso <|-- Libro : hereda
  Usuario "1" --> "0..*" Reserva : realiza
  Recurso "1" --> "0..*" Reserva : corresponde
  Reserva "1" *-- "1" QR : posee
  Usuario "1" --> "0..*" Sancion : recibe
  Sancion "0..1" --> "0..1" Reserva : origen
