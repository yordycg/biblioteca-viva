# Copia este archivo como .env y ajusta solo para desarrollo local.
# No uses credenciales reales.
DJANGO_SECRET_KEY=dev-only-bibliotecaviva
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Modo demostración para fijar la hora de RF-07.
DEMO_MODE=0
DEMO_NOW=
